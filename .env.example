# Managed Webdev supplies DATABASE_URL for MySQL. Leave blank for standalone local SQLite.
DATABASE_URL=

# Run `python -m alembic upgrade head` before launching the app; schema auto-creation stays off by default.
CAREERINSIGHT_AUTO_CREATE=false

# Public HTTPS uses secure defaults. For plain HTTP local development only:
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Password reset is unavailable until SMTP and a verified public origin are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
PUBLIC_APP_URL=

# Comma-separated emails allowed to register with research access.
RESEARCH_ADMIN_EMAILS=

# The managed runtime injects these optional server-side Manus AI service values. Never put secrets in frontend code.
MANUS_API_URL=
MANUS_API_KEY=
LLM_MODEL=

# Optional runtime settings.
UPLOAD_MAX_MB=8
